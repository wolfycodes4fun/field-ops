# Postgres container variables
POSTGRES_USER=<container-sudo-user>
POSTGRES_PASSWORD=<container-sudo-user-password>

# Postgres internal for app credentials
DB_USER=<db-user>
DB_PASSWORD=<db-password>
DB_HOST=<hostname>
ASSET_DB_NAME=assets
WORK_ORDER_DB_NAME=workorders
WORKFORCE_DB_NAME=workforce

# Authentication and Authorization
JWT_SECRET_KEY=<your_symmetric_or_private_asymmetric_key>